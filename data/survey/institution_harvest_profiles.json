{
  "schema_version": "slide-survey-institution-harvest-profiles-v1",
  "purpose": "Institution-specific bounded metadata profiles. Explicit profiles handle the high-yield systems; every remaining automatable strict institution receives a generic fallback profile selected from its survey automation mode.",
  "defaults": {
    "page_budget": 12,
    "absolute_page_cap": 120,
    "max_bytes": 4000000
